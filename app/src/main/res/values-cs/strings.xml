    <!-- Advanced -->
    <string name="advanced_title">Pokročilé doplňky</string>
    <string name="advanced_intro">Všechno tady je nepovinné a aplikace funguje i bez toho – úpravy pro fotoaplikace jsou zkratky pro konkrétní telefony a zůstanou vypnuté, dokud je nezapnete. Nastavení obrazovky dole je společné s plovoucím panelem série, takže ukazuje, co panel právě dělá.</string>
    <string name="advanced_profile">Použitý profil fotoaplikace: %1$s</string>
    <string name="advanced_launch_mode">Spustit fotoaparát v režimu</string>
    <string name="advanced_launch_mode_desc">Před prvním snímkem přepne fotoaplikaci do zvoleného režimu.</string>
    <string name="advanced_launch_mode_none">Nechat aplikaci, jak je</string>
    <string name="advanced_launch_mode_photo">Foto</string>
    <string name="advanced_launch_mode_night">Noční režim</string>
    <string name="advanced_launch_mode_astro">Astrofotografie</string>
    <string name="advanced_launch_mode_unavailable">Profil pro aplikaci %1$s nezná její tlačítka režimů, takže není do čeho přepnout.</string>
    <string name="advanced_launch_mode_unsupported">Režim %1$s profil pro aplikaci %2$s přepnout neumí, takže se nic nepřepne. Vyberte některý z režimů níže.</string>
    <string name="advanced_adaptive_wait">Přizpůsobit čekání dlouhé expozici</string>
    <string name="advanced_adaptive_wait_desc">Počká na dokončení dlouhé expozice místo kliknutí po pevně dané době.</string>
    <string name="advanced_self_timer">Zkontrolovat vypnutou samospoušť</string>
    <string name="advanced_self_timer_desc">Před spuštěním ověří nastavení samospouště ve fotoaplikaci, protože samospoušť by posunula každý snímek.</string>
    <string name="advanced_dismiss_post_capture">Zavírat obrazovky po snímku</string>
    <string name="advanced_dismiss_post_capture_desc">Zavře náhled nebo sdílení, které některé fotoaplikace zobrazí po snímku a které by spolklo další kliknutí.</string>
    <string name="advanced_session_screen">Obrazovka během série</string>
    <string name="advanced_keep_screen_on">Nechat obrazovku zapnutou při fotografování</string>
    <string name="advanced_keep_screen_on_desc">Drží displej vzhůru po celou dobu, kdy série skutečně fotí, protože většina fotoaplikací se zhasnutou obrazovkou přestane zobrazovat náhled – a tím i fotit. Stojí to baterii a obrazovka svítí celou dobu.</string>
    <string name="advanced_dim_overlay">Ztlumit ovládání na obrazovce</string>
    <string name="advanced_dim_overlay_desc">Ztlumí plovoucí panel série, aby nesvítil do scény, kterou fotíte. Dotykem se zase rozsvítí.</string>
    <string name="advanced_reason_needs_overlay">Vyžaduje oprávnění kreslit přes ostatní aplikace: dělá to plovoucí panel série. Povolte ho v Oprávněních.</string>
    <string name="advanced_reason_needs_pixel">Vyžaduje jako vybranou aplikaci Pixel Camera (com.google.android.GoogleCamera). Nyní vybráno: %1$s</string>
    <string name="advanced_reason_needs_app">Nejdřív vyberte fotoaplikaci.</string>

    <!-- Onboarding / permissions -->
    <string name="onboarding_title">Oprávnění</string>
    <string name="onboarding_intro">Aplikace mačká spoušť za vás, takže si Android nejdřív řekne o několik věcí. Seznam se aktualizuje živě – po každém kroku se sem vraťte.</string>
    <string name="onboarding_granted">Povoleno</string>
    <string name="onboarding_missing">Ještě nepovoleno</string>
    <string name="onboarding_optional">Nepovinné</string>
    <string name="onboarding_restricted_title">Povolit omezená nastavení</string>
    <string name="onboarding_restricted_desc">Protože tato instalace nepochází z obchodu, Android blokuje přepínač služby zpřístupnění, dokud ho neodblokujete: otevřete Informace o aplikaci, klepněte na nabídku v pravém horním rohu, zvolte Povolit omezená nastavení a potvrďte. Pak se vraťte a zapněte službu níže.</string>
    <string name="onboarding_restricted_action">Otevřít informace o aplikaci</string>
    <string name="onboarding_restricted_not_needed">Pro tuto instalaci není potřeba.</string>
    <string name="onboarding_accessibility_title">Služba zpřístupnění pro spoušť</string>
    <string name="onboarding_accessibility_desc">Jediný způsob, jak může aplikace zmáčknout spoušť v jiné aplikaci. Najděte CAELIS – spoušť mezi nainstalovanými nebo staženými aplikacemi a zapněte ji.</string>
    <string name="onboarding_accessibility_action">Otevřít nastavení zpřístupnění</string>
    <string name="onboarding_overlay_title">Kreslení přes ostatní aplikace</string>
    <string name="onboarding_overlay_desc">Potřebné pro zobrazení kalibračního zaměřovače a ovládání série nad fotoaplikací.</string>
    <string name="onboarding_overlay_action">Otevřít nastavení překryvů</string>
    <string name="onboarding_notifications_title">Oznámení</string>
    <string name="onboarding_notifications_desc">Zobrazí běžící sérii, počítadlo snímků a případná upozornění, i když je na obrazovce fotoaplikace.</string>
    <string name="onboarding_notifications_action">Povolit oznámení</string>
    <string name="onboarding_battery_title">Ignorovat optimalizaci baterie</string>
    <string name="onboarding_battery_desc">Bez této výjimky může Android aplikaci během dlouhé série uspat a snímky pak chybí.</string>
    <string name="onboarding_battery_action">Požádat o výjimku</string>
    <string name="onboarding_media_title">Přístup k fotkám pro kontrolu snímků</string>
    <string name="onboarding_media_desc">Vyžádá se jen tehdy, když v nastavení série zapnete kontrolu uložených snímků.</string>
    <string name="onboarding_all_set">Vše, co aplikace potřebuje, je povolené.</string>

