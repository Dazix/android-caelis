    <!-- Setup -->
    <string name="setup_title">Nastavení série</string>
    <string name="setup_mode">Režim</string>
    <string name="setup_mode_timelapse">Timelapse</string>
    <string name="setup_mode_timelapse_desc">Při spuštění série přepne dopředu vybranou fotoaplikaci a pak mačká její spoušť, takže každý snímek má plnou kvalitu dané aplikace. Nechte ji na obrazovce a displej zapnutý: když zmizí, série se pozastaví, dokud se nevrátí.</string>
    <string name="setup_mode_periodic">Periodické klikání</string>
    <string name="setup_mode_periodic_desc">Jen klikne na zkalibrované místo podle časovače, ať je na obrazovce cokoli. Vhodné i pro aplikace, které nejsou fotoaparát.</string>
    <string name="setup_interval">Interval</string>
    <string name="setup_interval_desc">Doba mezi dvěma snímky.</string>
    <string name="setup_interval_floor">Tato fotoaplikace potřebuje mezi snímky alespoň %1$s.</string>
    <string name="setup_shots">Počet snímků</string>
    <string name="setup_shots_unlimited">Fotit, dokud sérii nezastavím</string>
    <string name="setup_shots_count">Snímky</string>
    <string name="setup_start_delay">Zpoždění startu</string>
    <string name="setup_start_delay_desc">Čekání před prvním snímkem, abyste mohli telefon odložit.</string>
    <string name="setup_stop_conditions">Podmínky ukončení</string>
    <string name="setup_stop_conditions_desc">Série se sama ukončí, jakmile je splněná kterákoli z nich.</string>
    <string name="setup_max_duration">Maximální délka</string>
    <string name="setup_min_battery">Zastavit pod úrovní baterie</string>
    <string name="setup_min_battery_value">%1$d %%</string>
    <string name="setup_min_free_space">Zastavit pod volným místem</string>
    <string name="setup_verify_captures">Kontrolovat uložené snímky</string>
    <string name="setup_verify_captures_desc">Po každém snímku aplikace zkontroluje, že skutečně vznikla nová fotka, a upozorní vás, když fotoaplikace přestala ukládat. Kvůli tomu musí číst vaši galerii, a proto si Android při zapnutí této volby řekne o oprávnění k fotkám. Když volbu necháte vypnutou, o přístup k fotkám se vůbec nežádá.</string>
    <string name="setup_verify_permission_needed">Kontrola potřebuje přístup ke všem fotkám a zatím ho nemá. Série normálně poběží a bude fotit – jen vám neřekne, když fotoaplikace přestane ukládat.</string>
    <string name="setup_verify_permission_partial">Aplikace vidí jen fotky, které jste vybrali, takže na snímky z této série nedosáhne. Otevřete nastavení aplikace a u Fotky a videa zvolte Povolit vše.</string>
    <string name="setup_verify_open_settings">Otevřít nastavení aplikace</string>
    <string name="setup_verify_permission_granted">Oprávnění k fotkám je udělené.</string>
    <string name="setup_tap_area">Místo dotyku</string>
    <string name="setup_tap_area_none">Zatím není nic zkalibrované. Použijte Kalibrovat na hlavní obrazovce: jedno klepnutí uloží bod, tažením označíte oblast.</string>
    <string name="setup_tap_area_point">Zkalibrováno jako jediný bod.</string>
    <string name="setup_tap_area_rect">Zkalibrováno jako oblast.</string>
    <string name="setup_tap_jitter">Rozptýlit dotyky po oblasti</string>
    <string name="setup_tap_jitter_desc">Každý dotyk dopadne na náhodný pixel uvnitř zkalibrované oblasti místo vždy do jejího středu.</string>
    <string name="setup_tap_jitter_needs_area">Aby šlo zapnout, zkalibrujte oblast tažením obdélníku.</string>

