// Pre-rendered labels and badges (a SpriteAtlas) pinned to a sky direction, 1:1 in screen pixels.
//
// These were drawn by a Compose overlay once, which the TextureView showed 2-3 vsyncs apart from
// the GPU frame, so held in the hand the names jumped against the stars. Here they are part of the
// same frame. Colours, shadows and emoji are baked into the atlas (themed on the CPU, like line and
// disc), so the fragment only fades the sprite.
//
// Per-vertex: position = the anchor's sky direction (model space), uv0 = atlas coordinate,
// custom0 = (dxPx, dyPx, alpha, angleRad): this corner's offset from the anchor in screen pixels, Y down,
// custom1 = (marginXPx, marginYPx, liftPx, align): hide the sprite while its anchor is that close to an edge.
//
// With align = 1 the sprite is laid out against the horizon instead of the screen: its "up" is the
// local vertical at the anchor (the projected direction towards the zenith), its pivot is liftPx
// along that vertical, and it is turned a further angleRad counter-clockwise around the pivot. The
// peak names use it: held screen-upright, a name swung against the ridge whenever the phone rolled.
// TiltedLabel is the CPU twin of this layout (clearance); keep the two in step.
material {
    name : Label,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    doubleSided : true,
    requires : [ uv0, custom0, custom1 ],
    parameters : [
        { type : sampler2d, name : atlas, precision : medium }
    ],
    variables : [ labelAlpha ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float4 c = getCustom0();
        float4 m = getCustom1();
        float3 wp = material.worldPosition.xyz;
        float4 viewPos = mulMat4x4Float3(getViewFromWorldMatrix(), wp);
        float dist = -viewPos.z;
        // Behind the camera: collapse, never mirror onto the screen.
        bool visible = dist > 1e-4;
        if (visible && (m.x > 0.0 || m.y > 0.0)) {
            float4 clip = mulMat4x4Float3(getClipFromViewMatrix(), viewPos.xyz);
            float2 res = getResolution().xy;
            float2 px = (clip.xy / clip.w * 0.5 + 0.5) * res;
            visible = px.x >= m.x && px.x <= res.x - m.x && px.y >= m.y && px.y <= res.y - m.y;
        }
        // World units per screen pixel at the anchor's depth, as in disc.mat.
        float worldPerPx = visible
            ? 2.0 * dist / (getClipFromViewMatrix()[1][1] * getResolution().y)
            : 0.0;
        float3 right = getWorldFromViewMatrix()[0].xyz;
        float3 up = getWorldFromViewMatrix()[1].xyz;
        // Snap the anchor to a whole screen pixel: the sprite is 1:1 with its texels, and at a
        // fractional position linear filtering smears every glyph across two pixels, which is what
        // made names on the horizon look blurred while the phone moved.
        float2 snap = float2(0.0);
        float2 offset = c.xy;
        if (visible) {
            float4 aClip = mulMat4x4Float3(getClipFromViewMatrix(), viewPos.xyz);
            float2 aPx = (aClip.xy / aClip.w * 0.5 + 0.5) * getResolution().xy;
            snap = floor(aPx + 0.5) - aPx;
            if (m.w > 0.5) {
                // The local vertical: where a small step towards the zenith lands, Y down like c.xy.
                float3 zenith = normalize(mulMat3x3Float3(getWorldFromModelMatrix(), float3(0.0, 0.0, 1.0)));
                float4 bView = mulMat4x4Float3(getViewFromWorldMatrix(), wp + zenith * (dist * 0.002));
                float4 bClip = mulMat4x4Float3(getClipFromViewMatrix(), bView.xyz);
                float2 d = (bClip.xy / bClip.w * 0.5 + 0.5) * getResolution().xy - aPx;
                float len = length(d);
                float2 u = (bView.z < 0.0 && len > 1e-3) ? float2(d.x, -d.y) / len : float2(0.0, -1.0);
                float2 r = float2(-u.y, u.x);
                float ca = cos(c.w);
                float sa = sin(c.w);
                float2 t = r * ca + u * sa;
                float2 n = u * ca - r * sa;
                offset = u * m.z + t * c.x - n * c.y;
            }
        }
        material.worldPosition.xyz = wp + (right * (offset.x + snap.x) - up * (offset.y - snap.y)) * worldPerPx;
        material.labelAlpha = float4(visible ? c.z : 0.0, 0.0, 0.0, 0.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // The atlas is premultiplied (uploaded from a Bitmap).
        material.baseColor = texture(materialParams_atlas, getUV0()) * variable_labelAlpha.x;
    }
}
