namespace com.dazix.caelis.data.nightsky;

// Structs are stored inline in memory (fixed size). 
// This guarantees zero-allocation sequential reads for the rendering loop.
struct Star {
  ra: float;
  dec: float;
  mag: float;
}

// Tables are extensible. Used for metadata that isn't read every frame.
table StarMetadata {
  star_index: int; // Points to the index in the 'stars' vector
  name: string;
  body_type: string;         // English class, shown via sky_names.tsv "type.<snake_case>"
  constellation: string;     // IAU code, e.g. "CMa"
  distance_ly: float;
}

table Constellation {
  name: string;
  centroid_ra: float; // For center-screen focus detection
  centroid_dec: float;
  // Sequence of star indices representing line segments (e.g., [A, B, B, C] for a connected line)
  lines: [int];
  localized_name: string (deprecated); // names live in res/raw*/sky_names.tsv, keyed by id
  brightest_star: string;
  family: string;
  is_asterism: bool;
  art_resource_name: string; // e.g., "art_uma"
  // Celestial coordinates for the 4 image corners (TL, TR, BR, BL) in degrees
  art_corner_ra: [float];
  art_corner_dec: [float];
  id: string; // IAU code ("UMa") or Stellarium asterism code ("BDr"): the sky_names.tsv key
}

enum DsoType : byte {
  Galaxy = 0,
  GlobularCluster = 1,
  OpenCluster = 2,
  Nebula = 3,
  PlanetaryNebula = 4
}

table DeepSkyObject {
  messier_id: short;         // e.g., 31 for M31
  ra: float;                 // Right Ascension in degrees (0.0 - 360.0)
  dec: float;                // Declination in degrees (-90.0 - +90.0)
  mag: float;                // Visual magnitude
  size_arcmin: float;        // Angular size in arcminutes (for rendering scale)
  type: DsoType;
  localized_name: string (deprecated); // names live in res/raw*/sky_names.tsv as "dso.M<id>"
  constellation_id: string;  // IAU 3-letter code (e.g., "And")
  english_name: string;      // e.g., "Andromeda Galaxy"
  ngc_id: string;            // e.g., "NGC 224"
  position_angle_deg: float; // Major axis rotation in degrees [0.0, 180.0)
  axis_ratio: float;         // Minor/Major axis ratio b/a (0.1 .. 1.0)
  art_resource_name: string; // e.g., "dso_m31" (optional texture)
  art_width_deg: float;      // Real angular width on celestial sphere (degrees)
  art_rotation_deg: float;   // Local rotation offset in degrees
}

table MeteorShower {
  id: short;                 // Internal ID
  name: string;              // English, e.g. "Perseids"; shown via sky_names.tsv "met.<id>"
  ra: float;                 // J2000.0 Right Ascension (degrees)
  dec: float;                // J2000.0 Declination (degrees)
  zhr: short;                // Zenithal Hourly Rate (peak activity)
  peak_month: byte;          // 1-12
  peak_day: byte;            // 1-31
  constellation_id: string;  // IAU 3-letter code, e.g., "Per"
}

table NightSkyCatalog {
  // Fast loop data: Tightly packed contiguous memory block
  stars: [Star];
  
  // Slower metadata: Accessed only when needed
  metadata: [StarMetadata];
  constellations: [Constellation];
  dsos: [DeepSkyObject];
  meteor_showers: [MeteorShower];
}

root_type NightSkyCatalog;

