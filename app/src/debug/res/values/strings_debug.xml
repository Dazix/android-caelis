<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant-only resources for the test harness.

  The `shutter_button` id is the point of this file: the accessibility node of the fake shutter
  reports `viewIdResourceName = "com.dazix.caelis:id/shutter_button"` only because the id
  comes from a real resource, so the service exercises its real id-based node search.

  The content description is intentionally NOT a string resource - it is a Kotlin constant
  (FakeCameraActivity.SHUTTER_CONTENT_DESCRIPTION) so no locale can change what the node reports.
-->
<resources>

    <item
        name="shutter_button"
        type="id" />

    <string name="debug_fake_camera_label">Fake Camera (debug)</string>

</resources>
