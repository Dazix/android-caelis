<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only test harness surface. This manifest is merged into the debug variant only, so neither
  the fake camera nor the debug session entry point exists in a release build.

  See scripts/README.md for the exact adb invocations (they cannot be quoted here: a double hyphen
  is illegal inside an XML comment).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!--
          Exported so the activity can be launched from adb for the harness user.
          singleTop plus onNewIntent lets a test re-launch it to clear the tap log or swap render
          mode without tearing the activity down.
        -->
        <activity
            android:name=".debug.FakeCameraActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/debug_fake_camera_label"
            android:launchMode="singleTop"
            android:taskAffinity="com.dazix.caelis.debug.fakecamera"
            android:theme="@style/Theme.Caelis" />

        <!--
          P0 spike for the Filament sky (ARCore/Filament migration). Exported so adb can start it
          in the development user; debug variant only.
        -->
        <activity
            android:name=".debug.FilamentSpikeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/debug_filament_spike_label"
            android:theme="@style/Theme.Caelis" />

        <!--
          Debug-only session entry point for scripts/e2e_pixel_camera.sh. Exported because adb
          broadcasts arrive from the shell uid; debug variant only, never shipped.
        -->
        <receiver
            android:name=".debug.DebugSessionReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.dazix.caelis.debug.START_SESSION" />
                <action android:name="com.dazix.caelis.debug.STOP_SESSION" />
                <action android:name="com.dazix.caelis.debug.CLEAR_TAP_LOG" />
                <action android:name="com.dazix.caelis.debug.SET_AR_DISPLAY_LAG" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
